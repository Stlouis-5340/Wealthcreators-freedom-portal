generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Same models as prisma/schema.prisma. Vercel generates this client and migrates Postgres.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Portal account. role is "member" or "guide".
model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String
  role         String
  lastActive   String   @default("")
  coachingNote String   @default("")
  rosterSort   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guiding       GuideAssignment[] @relation("GuideUser")
  guides        GuideAssignment[] @relation("MemberUser")
  expenses      ExpenseLine[]
  streams       PassiveStream[]
  assets        AssetLine[]
  liabilities   LiabilityLine[]
  goals         Goal[]
  plaidItems    PlaidItem[]
  checkIns      WeeklyCheckIn[]
  notesAbout    CoachingNote[]    @relation("NoteMember")
  notesWritten  CoachingNote[]    @relation("NoteGuide")
  tasksAbout    CoachingTask[]    @relation("TaskMember")
  tasksAssigned CoachingTask[]    @relation("TaskGuide")
  reports       MonthlyReport[]
}

model GuideAssignment {
  guideId  String
  memberId String
  sort     Int    @default(0)
  guide    User   @relation("GuideUser", fields: [guideId], references: [id], onDelete: Cascade)
  member   User   @relation("MemberUser", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([guideId, memberId])
}

model ExpenseLine {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  monthly  Float
  note     String
  sort     Int

  @@index([memberId])
}

model PassiveStream {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  monthly  Float
  source   String
  sort     Int

  @@index([memberId])
}

model AssetLine {
  id          String @id
  memberId    String
  member      User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name        String
  institution String
  group       String
  balance     Float
  sort        Int
  /// Manual balance flag: "estimated" or "verified". Connected lines use PlaidItem.refreshedAt.
  valuation   String    @default("estimated")
  /// When the member last confirmed a manual balance. Null has no refresh clock. See STALE_AFTER_MS in lib/integrity.ts.
  confirmedAt DateTime?

  @@index([memberId])
}

model LiabilityLine {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  balance  Float
  note     String
  sort     Int

  @@index([memberId])
}

model Goal {
  id             String       @id
  memberId       String
  member         User         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  summary        String
  progressSource String
  baseline       Float?
  baselineLabel  String?
  target         Float?
  targetLabel    String
  sort           Int
  checkpoints    Checkpoint[]
  steps          GoalStep[]

  @@index([memberId])
}

model Checkpoint {
  id           String @id
  goalId       String
  goal         Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  year         Int
  calendarYear Int
  label        String
  targetValue  Float?
  sort         Int

  @@index([goalId])
}

/// A member's Plaid Item. accessTokenEnc is an AES-256-GCM payload, never a client field.
model PlaidItem {
  id              String         @id @default(cuid())
  memberId        String
  member          User           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  itemId          String         @unique
  accessTokenEnc  String
  institutionId   String         @default("")
  institutionName String
  createdAt       DateTime       @default(now())
  /// Last successful balance refresh. Older than STALE_AFTER_MS in lib/integrity.ts is labeled stale.
  refreshedAt     DateTime       @default(now())
  accounts        PlaidAccount[]

  @@index([memberId])
}

model PlaidAccount {
  id              String    @id @default(cuid())
  itemRecordId    String
  item            PlaidItem @relation(fields: [itemRecordId], references: [id], onDelete: Cascade)
  plaidAccountId  String    @unique
  name            String
  type            String
  subtype         String    @default("")
  mask            String    @default("")
  balance         Float
  assetLineId     String?   @unique
  liabilityLineId String?   @unique

  @@index([itemRecordId])
}

model GoalStep {
  id     String  @id
  goalId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title  String
  detail String
  done   Boolean
  sort   Int

  @@index([goalId])
}

/// One Freedom check-in per member per America/Chicago calendar week.
/// weekKey is that week's Monday, YYYY-MM-DD. A later save in the same week updates this row.
/// actionStatus is "yes", "partial", or "no".
model WeeklyCheckIn {
  id                String   @id @default(cuid())
  memberId          String
  member            User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  weekKey           String
  win               String
  challenge         String
  actionStatus      String
  commitment        String
  needsSupport      Boolean
  supportNote       String   @default("")
  summary           String
  freedomScore      Float?
  monthlyFreedomGap Float?
  qualityScore      Float?
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([memberId, weekKey])
  @@index([memberId])
  @@index([weekKey])
}

/// Timestamped note a Wealth Guide writes about a member. Separate from User.coachingNote.
model CoachingNote {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("NoteMember", fields: [memberId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User     @relation("NoteGuide", fields: [guideId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([guideId])
}

/// Follow-up a Wealth Guide assigns. status is "open" or "done". dueDate is YYYY-MM-DD or empty.
model CoachingTask {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("TaskMember", fields: [memberId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User     @relation("TaskGuide", fields: [guideId], references: [id], onDelete: Cascade)
  title     String
  dueDate   String   @default("")
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([guideId])
  @@index([status])
}

/// One Freedom Report per member per America/Chicago calendar month.
/// monthKey is YYYY-MM. Opening the current month refreshes this row.
/// goalsSummary, milestones, and actions are JSON text.
model MonthlyReport {
  id            String   @id @default(cuid())
  memberId      String
  member        User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthKey      String
  freedomScore  Float?
  gap           Float?
  quality       Float?
  passive       Float?
  expenses      Float?
  netWorth      Float?
  yieldOnAssets Float?
  goalsSummary  String
  milestones    String
  actions       String
  generatedAt   DateTime @default(now())

  @@unique([memberId, monthKey])
  @@index([memberId])
  @@index([monthKey])
}
