generator client {
  provider = "prisma-client-js"
}

// Local SQLite. Production uses prisma/postgres/schema.prisma (same models).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Portal account. role is "member", "guide", or "admin".
/// isActive false cannot sign in. mfaSecretEnc is an AES payload, never a client field.
model User {
  id                  String   @id
  email               String   @unique
  passwordHash        String
  name                String
  role                String
  lastActive          String   @default("")
  coachingNote        String   @default("")
  rosterSort          Int      @default(0)
  /// Starting circumstance for leadership views, such as Foundation or Building. Empty means unassigned. Not a rank.
  cohort              String   @default("")
  isActive            Boolean  @default(true)
  mfaEnabled          Boolean  @default(false)
  mfaSecretEnc        String   @default("")
  mfaPendingSecretEnc String   @default("")
  mfaRecoveryHashes   String   @default("[]")
  /// Guide scheduling page, usually a Calendly link. Empty uses NEXT_PUBLIC_GUIDE_SCHEDULING_URL.
  schedulingUrl       String   @default("")
  /// Bumped when the password changes so older sign-in sessions stop working.
  passwordVersion     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  guiding        GuideAssignment[] @relation("GuideUser")
  guides         GuideAssignment[] @relation("MemberUser")
  expenses       ExpenseLine[]
  streams        PassiveStream[]
  assets         AssetLine[]
  liabilities    LiabilityLine[]
  goals          Goal[]
  plaidItems     PlaidItem[]
  checkIns       WeeklyCheckIn[]
  notesAbout     CoachingNote[]    @relation("NoteMember")
  notesWritten   CoachingNote[]    @relation("NoteGuide")
  tasksAbout     CoachingTask[]    @relation("TaskMember")
  tasksAssigned  CoachingTask[]    @relation("TaskGuide")
  reports        MonthlyReport[]
  grantsAsMember    GuideAccessGrant[]    @relation("GrantMember")
  grantsAsGuide     GuideAccessGrant[]    @relation("GrantGuide")
  auditLogs         AuditLog[]
  scenarios         ScenarioRun[]
  coachThreads      CoachThread[]
  actionPlans       FreedomActionPlan[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  hubMessages       HubMessage[]          @relation("HubAuthor")
  hubThreads        HubMessage[]          @relation("HubMember")
  sessionsAbout     SessionSummary[]      @relation("SessionMember")
  sessionsHeld      SessionSummary[]      @relation("SessionGuide")
  agendaItems       AgendaItem[]
  hubReads          HubRead[]             @relation("HubReader")
  hubReadAbout      HubRead[]             @relation("HubReadMember")
  enrollments       ChallengeEnrollment[]
  lessonCompletions LessonCompletion[]
  achievements      Achievement[]
  lifeMetrics       LifeMetrics?
  legacyPlan        LegacyPlan?
  groupsCreated     AccountabilityGroup[] @relation("GroupCreator")
  invitesCreated    MemberInvite[]        @relation("InviteCreator")
  invitesGuiding    MemberInvite[]        @relation("InviteGuide")
  passwordResets    PasswordReset[]
}

model GuideAssignment {
  guideId  String
  memberId String
  sort     Int    @default(0)
  guide    User   @relation("GuideUser", fields: [guideId], references: [id], onDelete: Cascade)
  member   User   @relation("MemberUser", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([guideId, memberId])
}

model ExpenseLine {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  monthly  Float
  note     String
  sort     Int

  @@index([memberId])
}

model PassiveStream {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  monthly  Float
  source   String
  sort     Int

  @@index([memberId])
}

model AssetLine {
  id          String @id
  memberId    String
  member      User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name        String
  institution String
  group       String
  balance     Float
  sort        Int
  /// Manual balance flag: "estimated" or "verified". Connected lines use PlaidItem.refreshedAt.
  valuation   String    @default("estimated")
  /// When the member last confirmed a manual balance. Null has no refresh clock. See STALE_AFTER_MS in lib/integrity.ts.
  confirmedAt DateTime?
  /// income, appreciation, lifestyle, or empty. Empty means the portal assumed a role.
  capitalRole String    @default("")

  @@index([memberId])
}

model LiabilityLine {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  balance  Float
  note     String
  sort     Int

  @@index([memberId])
}

model Goal {
  id             String       @id
  memberId       String
  member         User         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  summary        String
  progressSource String
  baseline       Float?
  baselineLabel  String?
  target         Float?
  targetLabel    String
  sort           Int
  checkpoints    Checkpoint[]
  steps          GoalStep[]

  @@index([memberId])
}

model Checkpoint {
  id           String @id
  goalId       String
  goal         Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  year         Int
  calendarYear Int
  label        String
  targetValue  Float?
  sort         Int

  @@index([goalId])
}

/// A member's Plaid Item. accessTokenEnc is an AES-256-GCM payload, never a client field.
model PlaidItem {
  id              String         @id @default(cuid())
  memberId        String
  member          User           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  itemId          String         @unique
  accessTokenEnc  String
  institutionId   String         @default("")
  institutionName String
  createdAt       DateTime       @default(now())
  /// Last successful balance refresh. Older than STALE_AFTER_MS in lib/integrity.ts is labeled stale.
  refreshedAt     DateTime       @default(now())
  accounts        PlaidAccount[]

  @@index([memberId])
}

model PlaidAccount {
  id              String    @id @default(cuid())
  itemRecordId    String
  item            PlaidItem @relation(fields: [itemRecordId], references: [id], onDelete: Cascade)
  plaidAccountId  String    @unique
  name            String
  type            String
  subtype         String    @default("")
  mask            String    @default("")
  balance         Float
  assetLineId     String?   @unique
  liabilityLineId String?   @unique

  @@index([itemRecordId])
}

model GoalStep {
  id     String  @id
  goalId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title  String
  detail String
  done   Boolean
  sort   Int

  @@index([goalId])
}

/// One Freedom check-in per member per America/Chicago calendar week.
/// weekKey is that week's Monday, YYYY-MM-DD. A later save in the same week updates this row.
/// actionStatus is "yes", "partial", or "no".
model WeeklyCheckIn {
  id                String   @id @default(cuid())
  memberId          String
  member            User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  weekKey           String
  win               String
  challenge         String
  actionStatus      String
  commitment        String
  needsSupport      Boolean
  supportNote       String   @default("")
  summary           String
  freedomScore      Float?
  monthlyFreedomGap Float?
  qualityScore      Float?
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([memberId, weekKey])
  @@index([memberId])
  @@index([weekKey])
}

/// Timestamped note a Wealth Guide writes about a member. Separate from User.coachingNote.
model CoachingNote {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("NoteMember", fields: [memberId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User     @relation("NoteGuide", fields: [guideId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([guideId])
}

/// Shared action item. status is "open" or "done". dueDate is YYYY-MM-DD or empty.
/// source is "guide" or "member". Either person can mark it done.
model CoachingTask {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("TaskMember", fields: [memberId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User     @relation("TaskGuide", fields: [guideId], references: [id], onDelete: Cascade)
  title     String
  dueDate   String   @default("")
  status    String   @default("open")
  /// "guide" or "member".
  source    String   @default("guide")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([guideId])
  @@index([status])
}

/// One Freedom Report per member per America/Chicago calendar month.
/// monthKey is YYYY-MM. Opening the current month refreshes this row.
/// goalsSummary, milestones, and actions are JSON text.
model MonthlyReport {
  id            String   @id @default(cuid())
  memberId      String
  member        User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthKey      String
  freedomScore  Float?
  gap           Float?
  quality       Float?
  passive       Float?
  expenses      Float?
  netWorth      Float?
  yieldOnAssets Float?
  goalsSummary  String
  milestones    String
  actions       String
  generatedAt   DateTime @default(now())

  @@unique([memberId, monthKey])
  @@index([memberId])
  @@index([monthKey])
}

/// What an assigned Guide may see. Category spending and transactions are not scopes in v1.
/// scopes is JSON: score, totals, goals, checkIns, tasks, education, legacy.
/// legacy stays off until the member opts in. revokedAt null means the grant is on.
model GuideAccessGrant {
  id        String    @id @default(cuid())
  memberId  String
  guideId   String
  member    User      @relation("GrantMember", fields: [memberId], references: [id], onDelete: Cascade)
  guide     User      @relation("GrantGuide", fields: [guideId], references: [id], onDelete: Cascade)
  scopes    String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([memberId])
  @@index([guideId])
  @@index([memberId, guideId])
}

/// Security and coaching access events. meta is JSON and must not hold tokens or secrets.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  meta        String   @default("{}")
  ip          String   @default("")
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([actorUserId])
}

/// A saved forecast or what-if. assumptions and outputs are JSON text.
/// sharedWithGuide false stays off the Guide view. Guides still need an assignment and the member's scopes.
model ScenarioRun {
  id              String   @id @default(cuid())
  memberId        String
  member          User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name            String
  assumptions     String
  outputs         String
  sharedWithGuide Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([memberId])
  @@index([memberId, sharedWithGuide])
}

/// One Freedom Coach conversation per member. Messages stay when the monthly plan is refreshed.
model CoachThread {
  id        String         @id @default(cuid())
  memberId  String
  member    User           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  CoachMessage[]

  @@index([memberId])
}

/// role is "user" or "assistant". body is the visible text. No tokens or bank payloads.
model CoachMessage {
  id        String      @id
  threadId  String
  thread    CoachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  body      String
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}

/// One Freedom Action Plan per member per America/Chicago month.
/// actions and previousActions are JSON with three educational actions.
/// A member refresh updates this row, keeps the prior JSON, and stamps regeneratedAt.
model FreedomActionPlan {
  id              String    @id @default(cuid())
  memberId        String
  member          User      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthKey        String
  actions         String
  previousActions String    @default("")
  /// "seed" or "generated"
  source          String    @default("generated")
  generatedAt     DateTime  @default(now())
  regeneratedAt   DateTime?

  @@unique([memberId, monthKey])
  @@index([memberId])
}

/// A curated learning path. Lessons are educational. They are not advice.
model LearningPath {
  id       String   @id
  title    String
  summary  String
  sort     Int
  lessons  Lesson[]
}

/// One lesson. level is "beginner" or "intermediate". exercise empty means there is no checkbox.
model Lesson {
  id        String           @id
  pathId    String
  path      LearningPath     @relation(fields: [pathId], references: [id], onDelete: Cascade)
  title     String
  summary   String
  minutes   Int
  level     String
  body      String
  exercise  String           @default("")
  sort      Int
  questions QuizQuestion[]
  progress  LessonProgress[]
  attempts  QuizAttempt[]

  @@index([pathId])
}

/// Quiz prompt. choices is a JSON array of strings. answerIndex is the correct choice.
/// Guides do not receive this row. They see the score only.
model QuizQuestion {
  id          String @id
  lessonId    String
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt      String
  choices     String
  answerIndex Int
  sort        Int

  @@index([lessonId])
}

/// One row per member per lesson. status is "notStarted", "inProgress", or "completed".
model LessonProgress {
  id           String    @id @default(cuid())
  memberId     String
  member       User      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       String    @default("notStarted")
  completedAt  DateTime?
  exerciseDone Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  @@unique([memberId, lessonId])
  @@index([memberId])
  @@index([lessonId])
}

/// A finished quiz. score is a percent from 0 to 100. Answers are not stored.
model QuizAttempt {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score     Int
  correct   Int
  total     Int
  createdAt DateTime @default(now())

  @@index([memberId, lessonId])
}

/// Short note on the member–Guide thread. Not a live chat.
model HubMessage {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("HubMember", fields: [memberId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("HubAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

/// Guide's notes after a coaching session.
model SessionSummary {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("SessionMember", fields: [memberId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User     @relation("SessionGuide", fields: [guideId], references: [id], onDelete: Cascade)
  summary   String
  nextSteps String   @default("")
  heldAt    DateTime
  createdAt DateTime @default(now())

  @@index([memberId, heldAt])
}

/// Something the member wants on the next session agenda.
model AgendaItem {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([memberId])
}

/// When this person last opened the member's shared workspace. Used for the unread count.
model HubRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("HubReader", fields: [userId], references: [id], onDelete: Cascade)
  memberId   String
  member     User     @relation("HubReadMember", fields: [memberId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([userId, memberId])
  @@index([memberId])
}

/// Catalog row. durationDays is 30, 60, or 90. verifier selects the progress rule in lib/challenges.ts.
model Challenge {
  id           String                 @id
  title        String
  summary      String
  durationDays Int
  verifier     String
  sort         Int                    @default(0)
  enrollments  ChallengeEnrollment[]
  groups       AccountabilityGroup[]
}

/// One row per member per challenge. status is active, completed, or abandoned.
/// progress is 0–100. evidence is JSON and must not hold bank names or tokens.
model ChallengeEnrollment {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  memberId    String
  member      User      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status      String    @default("active")
  progress    Float     @default(0)
  evidence    String    @default("{}")
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  updatedAt   DateTime  @updatedAt

  @@unique([challengeId, memberId])
  @@index([memberId])
  @@index([status])
}

/// Small accountability circle for one challenge. memberIds is a JSON array of member ids.
model AccountabilityGroup {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  name        String
  memberIds   String
  createdById String
  createdBy   User      @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([challengeId])
  @@index([createdById])
}

/// A challenge lesson the member marked read. This is not a course catalog.
model LessonCompletion {
  id          String   @id @default(cuid())
  memberId    String
  member      User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lessonKey   String
  completedAt DateTime @default(now())

  @@unique([memberId, lessonKey])
  @@index([memberId])
}

/// Unlocked recognition. visibility is "private" or "guide".
/// Copy lives in lib/recognition.ts so a row cannot store dollar amounts.
model Achievement {
  id         String   @id @default(cuid())
  memberId   String
  member     User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  key        String
  visibility String   @default("private")
  unlockedAt DateTime @default(now())

  @@unique([memberId, key])
  @@index([memberId])
  @@index([memberId, visibility])
}

/// Optional self-reported life measures. One row per member. updatedAt is lastUpdated.
model LifeMetrics {
  memberId           String   @id
  member             User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  timeFreedomHours   Float?
  familyPriority     Int?
  healthStreakDays   Int?
  experiencesPlanned String   @default("")
  updatedAt          DateTime @updatedAt
}

/// One legacy organizer per member. Narrative fields are the member's own words.
/// Educational notes only. Not a will, trust, or legal filing. No SSN column exists.
model LegacyPlan {
  memberId             String   @id
  member               User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// not_started, exploring, drafted, signed, funded, reviewing, or na.
  trustStatus          String   @default("not_started")
  trustNotes           String   @default("")
  educationGoals       String   @default("")
  charitableIntentions String   @default("")
  priorities           String   @default("")
  updatedAt            DateTime @updatedAt

  checklist     LegacyChecklistItem[]
  beneficiaries LegacyBeneficiary[]
  insurance     LegacyInsurance[]
  documents     LegacyDocument[]
}

/// Estate and legacy checklist. status is not_started, in_progress, done, or na.
/// questions are notes for a qualified professional. Do not store SSNs or account numbers.
model LegacyChecklistItem {
  id        String     @id @default(cuid())
  planId    String
  plan      LegacyPlan @relation(fields: [planId], references: [memberId], onDelete: Cascade)
  key       String
  area      String
  title     String
  detail    String     @default("")
  status    String     @default("not_started")
  questions String     @default("")
  sort      Int
  updatedAt DateTime   @updatedAt

  @@unique([planId, key])
  @@index([planId])
}

/// A person or charity the member wants remembered. No SSN, tax id, or account number.
model LegacyBeneficiary {
  id           String     @id @default(cuid())
  planId       String
  plan         LegacyPlan @relation(fields: [planId], references: [memberId], onDelete: Cascade)
  name         String
  relationship String
  /// primary or contingent.
  role         String     @default("primary")
  notes        String     @default("")
  sort         Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([planId])
}

/// Coverage summary only. Do not store policy numbers.
model LegacyInsurance {
  id        String     @id @default(cuid())
  planId    String
  plan      LegacyPlan @relation(fields: [planId], references: [memberId], onDelete: Cascade)
  kind      String
  carrier   String     @default("")
  summary   String
  /// in_force, reviewing, none, or unknown.
  status    String     @default("unknown")
  notes     String     @default("")
  sort      Int
  updatedAt DateTime   @updatedAt

  @@index([planId])
}

/// Document metadata. Bytes are not stored.
/// storageKey is a private placeholder path, never a public URL.
/// TODO: when BLOB_READ_WRITE_TOKEN is configured, upload with private access and store only the pathname here.
model LegacyDocument {
  id           String     @id @default(cuid())
  planId       String
  plan         LegacyPlan @relation(fields: [planId], references: [memberId], onDelete: Cascade)
  title        String
  kind         String
  locationNote String     @default("")
  fileName     String     @default("")
  storageKey   String     @default("")
  notes        String     @default("")
  recordedAt   DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([planId])
}

/// Single-use member invite. tokenHash is the SHA-256 of the link token. The raw token is not stored.
model MemberInvite {
  id          String    @id @default(cuid())
  email       String
  name        String    @default("")
  tokenHash   String    @unique
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  guideId     String?
  guide       User?     @relation("InviteGuide", fields: [guideId], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([createdById])
  @@index([guideId])
}

/// Single-use password reset. tokenHash is the SHA-256 of the link token. The raw token is not stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
