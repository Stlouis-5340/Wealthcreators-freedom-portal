generator client {
  provider = "prisma-client-js"
}

// Local SQLite. Production uses prisma/postgres/schema.prisma (same models).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Portal account. role is "member", "guide", or "admin".
/// isActive false cannot sign in. mfaSecretEnc is an AES payload, never a client field.
model User {
  id                  String   @id
  email               String   @unique
  passwordHash        String
  name                String
  role                String
  lastActive          String   @default("")
  coachingNote        String   @default("")
  rosterSort          Int      @default(0)
  isActive            Boolean  @default(true)
  mfaEnabled          Boolean  @default(false)
  mfaSecretEnc        String   @default("")
  mfaPendingSecretEnc String   @default("")
  mfaRecoveryHashes   String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  guiding        GuideAssignment[] @relation("GuideUser")
  guides         GuideAssignment[] @relation("MemberUser")
  expenses       ExpenseLine[]
  streams        PassiveStream[]
  assets         AssetLine[]
  liabilities    LiabilityLine[]
  goals          Goal[]
  plaidItems     PlaidItem[]
  checkIns       WeeklyCheckIn[]
  notesAbout     CoachingNote[]    @relation("NoteMember")
  notesWritten   CoachingNote[]    @relation("NoteGuide")
  tasksAbout     CoachingTask[]    @relation("TaskMember")
  tasksAssigned  CoachingTask[]    @relation("TaskGuide")
  reports        MonthlyReport[]
  grantsAsMember GuideAccessGrant[] @relation("GrantMember")
  grantsAsGuide  GuideAccessGrant[] @relation("GrantGuide")
  auditLogs      AuditLog[]
  scenarios      ScenarioRun[]
}

model GuideAssignment {
  guideId  String
  memberId String
  sort     Int    @default(0)
  guide    User   @relation("GuideUser", fields: [guideId], references: [id], onDelete: Cascade)
  member   User   @relation("MemberUser", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([guideId, memberId])
}

model ExpenseLine {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  monthly  Float
  note     String
  sort     Int

  @@index([memberId])
}

model PassiveStream {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  monthly  Float
  source   String
  sort     Int

  @@index([memberId])
}

model AssetLine {
  id          String @id
  memberId    String
  member      User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name        String
  institution String
  group       String
  balance     Float
  sort        Int
  /// Manual balance flag: "estimated" or "verified". Connected lines use PlaidItem.refreshedAt.
  valuation   String    @default("estimated")
  /// When the member last confirmed a manual balance. Null has no refresh clock. See STALE_AFTER_MS in lib/integrity.ts.
  confirmedAt DateTime?
  /// income, appreciation, lifestyle, or empty. Empty means the portal assumed a role.
  capitalRole String    @default("")

  @@index([memberId])
}

model LiabilityLine {
  id       String @id
  memberId String
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name     String
  balance  Float
  note     String
  sort     Int

  @@index([memberId])
}

model Goal {
  id             String       @id
  memberId       String
  member         User         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  summary        String
  progressSource String
  baseline       Float?
  baselineLabel  String?
  target         Float?
  targetLabel    String
  sort           Int
  checkpoints    Checkpoint[]
  steps          GoalStep[]

  @@index([memberId])
}

model Checkpoint {
  id           String @id
  goalId       String
  goal         Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  year         Int
  calendarYear Int
  label        String
  targetValue  Float?
  sort         Int

  @@index([goalId])
}

/// A member's Plaid Item. accessTokenEnc is an AES-256-GCM payload, never a client field.
model PlaidItem {
  id              String         @id @default(cuid())
  memberId        String
  member          User           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  itemId          String         @unique
  accessTokenEnc  String
  institutionId   String         @default("")
  institutionName String
  createdAt       DateTime       @default(now())
  /// Last successful balance refresh. Older than STALE_AFTER_MS in lib/integrity.ts is labeled stale.
  refreshedAt     DateTime       @default(now())
  accounts        PlaidAccount[]

  @@index([memberId])
}

model PlaidAccount {
  id              String    @id @default(cuid())
  itemRecordId    String
  item            PlaidItem @relation(fields: [itemRecordId], references: [id], onDelete: Cascade)
  plaidAccountId  String    @unique
  name            String
  type            String
  subtype         String    @default("")
  mask            String    @default("")
  balance         Float
  assetLineId     String?   @unique
  liabilityLineId String?   @unique

  @@index([itemRecordId])
}

model GoalStep {
  id     String  @id
  goalId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title  String
  detail String
  done   Boolean
  sort   Int

  @@index([goalId])
}

/// One Freedom check-in per member per America/Chicago calendar week.
/// weekKey is that week's Monday, YYYY-MM-DD. A later save in the same week updates this row.
/// actionStatus is "yes", "partial", or "no".
model WeeklyCheckIn {
  id                String   @id @default(cuid())
  memberId          String
  member            User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  weekKey           String
  win               String
  challenge         String
  actionStatus      String
  commitment        String
  needsSupport      Boolean
  supportNote       String   @default("")
  summary           String
  freedomScore      Float?
  monthlyFreedomGap Float?
  qualityScore      Float?
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([memberId, weekKey])
  @@index([memberId])
  @@index([weekKey])
}

/// Timestamped note a Wealth Guide writes about a member. Separate from User.coachingNote.
model CoachingNote {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("NoteMember", fields: [memberId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User     @relation("NoteGuide", fields: [guideId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([guideId])
}

/// Follow-up a Wealth Guide assigns. status is "open" or "done". dueDate is YYYY-MM-DD or empty.
model CoachingTask {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("TaskMember", fields: [memberId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User     @relation("TaskGuide", fields: [guideId], references: [id], onDelete: Cascade)
  title     String
  dueDate   String   @default("")
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([guideId])
  @@index([status])
}

/// One Freedom Report per member per America/Chicago calendar month.
/// monthKey is YYYY-MM. Opening the current month refreshes this row.
/// goalsSummary, milestones, and actions are JSON text.
model MonthlyReport {
  id            String   @id @default(cuid())
  memberId      String
  member        User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthKey      String
  freedomScore  Float?
  gap           Float?
  quality       Float?
  passive       Float?
  expenses      Float?
  netWorth      Float?
  yieldOnAssets Float?
  goalsSummary  String
  milestones    String
  actions       String
  generatedAt   DateTime @default(now())

  @@unique([memberId, monthKey])
  @@index([memberId])
  @@index([monthKey])
}

/// What an assigned Guide may see. Category spending and transactions are not scopes in v1.
/// scopes is JSON: score, totals, goals, checkIns, tasks. revokedAt null means the grant is on.
model GuideAccessGrant {
  id        String    @id @default(cuid())
  memberId  String
  guideId   String
  member    User      @relation("GrantMember", fields: [memberId], references: [id], onDelete: Cascade)
  guide     User      @relation("GrantGuide", fields: [guideId], references: [id], onDelete: Cascade)
  scopes    String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([memberId])
  @@index([guideId])
  @@index([memberId, guideId])
}

/// Security and coaching access events. meta is JSON and must not hold tokens or secrets.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  meta        String   @default("{}")
  ip          String   @default("")
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([actorUserId])
}

/// A saved forecast or what-if. assumptions and outputs are JSON text.
/// sharedWithGuide false stays off the Guide view. Guides still need an assignment and the member's scopes.
model ScenarioRun {
  id              String   @id @default(cuid())
  memberId        String
  member          User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name            String
  assumptions     String
  outputs         String
  sharedWithGuide Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([memberId])
  @@index([memberId, sharedWithGuide])
}
