{
  "name": "freedom-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Wealth Creators Freedom Portal — Freedom Score, yield on assets, and member goals.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-database.mjs && next build",
    "vercel-build": "node scripts/prepare-database.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=.env.local ./node_modules/prisma/build/index.js db seed",
    "db:migrate:postgres": "node scripts/prepare-database.mjs migrate",
    "db:seed:postgres": "node scripts/prepare-database.mjs seed"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.166",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.162",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "plaid": "^49.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-plaid-link": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
