# Auth.js signs the session cookie with this secret.
# Generate one locally and put it in .env.local (never commit the real value):
#   openssl rand -base64 32
# Set the same kind of value in the Vercel project for Production and Preview.
AUTH_SECRET=

# Origin of this app.
# Local: http://localhost:3000
# Production: https://your-app.vercel.app (the real Vercel URL, then redeploy once)
AUTH_URL=http://localhost:3000

# Allow Auth.js to trust the incoming host. Leave true for local, preview, and production.
AUTH_TRUST_HOST=true

# Local SQLite. Prisma resolves this relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Production Postgres (Vercel / Neon). Do not commit real URLs.
# Use the pooled host for DATABASE_URL and the direct host for DIRECT_URL.
# If the host has no pooler, set both to the same URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Plaid Link. v1 uses sandbox, including on the hosted demo.
# Leave the id and secret blank to keep the branded "not configured" state.
# Put real values in .env.local or in Vercel. Never commit them.
# Create a free sandbox app at https://dashboard.plaid.com — see the README.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Production Link later: PLAID_ENV=production and the production secret.

# Optional scheduling page for every Guide who has not saved their own link.
# A Guide profile link wins when it is set. The demo seed puts a placeholder on Jordan.
# NEXT_PUBLIC_GUIDE_SCHEDULING_URL=https://calendly.com/your-guide/session

# Freedom Coach. Leave the key blank to keep chat and plan generation off.
# The Coach page still opens. Alex's seeded plan and sample conversation stay.
# Put the real key in .env.local or in Vercel. Never commit it.
# AI_GATEWAY_MODEL is a Vercel AI Gateway id (provider/model). Unset uses openai/gpt-4.1-mini.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1-mini

# Optional Mighty Networks community home (http or https only).
# Example shape: https://your-network.mn.co
# Members always see Community. A full web address opens in a new tab.
# Leave this blank for a short "Community coming soon" page with no login form.
# Guides see the same link only when this is set. No OAuth and no database setting.
# Do not put a password or a sign-in token in this value.
MIGHTY_NETWORKS_URL=

# Outbound email for member invites and password reset. Leave both blank to keep
# the copy-link invite and a "email is not configured" note. Do not commit a real key.
# Marvin verifies wealthdomination.com in Resend before production mail can deliver.
# Suggested from address (the domain must be verified; this repo does not set DNS):
# EMAIL_FROM="Wealth Creators <noreply@wealthdomination.com>"
RESEND_API_KEY=
EMAIL_FROM=

# Legacy document files are not uploaded in this version.
# When a private store is added, set BLOB_READ_WRITE_TOKEN in .env.local or Vercel.
# Never commit the token. Until then the portal stores a title and a placeholder path only.
# BLOB_READ_WRITE_TOKEN=
