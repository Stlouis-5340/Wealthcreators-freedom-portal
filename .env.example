# Auth.js signs the session cookie with this secret.
# Generate one locally and put it in .env.local (never commit the real value):
#   npx auth secret
#   openssl rand -base64 32
AUTH_SECRET=

# Origin of this app. Use the local URL for `npm run dev`.
AUTH_URL=http://localhost:3000

# Allow Auth.js to trust the incoming host. Leave true for local and preview hosts.
AUTH_TRUST_HOST=true

# SQLite file for local development. Prisma resolves this relative to prisma/schema.prisma.
# For Postgres later, point this at a postgres:// URL and change the datasource provider.
DATABASE_URL="file:./dev.db"

# Plaid Link. v1 uses sandbox. Leave the id and secret blank to keep the branded
# "not configured" state. Put real values in .env.local only. Never commit them.
# Create a free sandbox app at https://dashboard.plaid.com — see the README.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
